# Somente o domínio, sem https://, porta, caminho ou barra final.
DOMAIN=persona.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br
BACKUP_INTERVAL_HOURS=6
# 120 cópias equivalem a aproximadamente 30 dias com intervalo de 6 horas.
BACKUP_KEEP=120

# Chat: funciona sem IA no modo local; troque para groq ao configurar sua chave.
AI_PROVIDER=local
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
